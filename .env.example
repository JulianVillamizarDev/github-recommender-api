DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Personal Access Token with `read:user` and `public_repo` scopes.
GITHUB_TOKEN=ghp_your_token_here

# Optional throttle overrides (DRF rates).
THROTTLE_ANON=20/min
THROTTLE_USER=60/min

# Optional: comma-separated GitHub logins to always exclude from recommendations
# (e.g. automation running under a real User account that type filtering misses).
RECOMMENDATION_DENYLIST=cursoragent,some-other-login
